# Variables de entorno para el backend de Manos Seguras

PORT=4000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL (ej. Supabase, Neon, Railway o Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/manos_seguras_db?schema=public"

# Clave Secreta para firma de Tokens JWT
JWT_SECRET="manos_seguras_super_secret_jwt_key_2026_clinical_wash"
JWT_EXPIRES_IN="7d"

# Orígenes Permitidos para CORS (Frontend Angular)
FRONTEND_URL="http://localhost:4200"
