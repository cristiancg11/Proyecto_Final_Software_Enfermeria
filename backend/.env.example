# Variables de entorno para el backend de Manos Seguras

PORT=3000
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL (Supabase: Pooler en 6543 con pgbouncer y Direct en 5432 para migraciones)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?connect_timeout=15"

# Clave Secreta para firma de Tokens JWT
JWT_SECRET="manos_seguras_super_secret_jwt_key_2026_clinical_wash"
JWT_EXPIRES_IN="7d"

# Orígenes Permitidos para CORS (Frontend Angular)
FRONTEND_URL="http://localhost:4200"
